# Path to the SQLite database file. Optional — defaults to ./data/carpulse.db
# (relative to the app's working directory). The directory is created
# automatically if it doesn't exist.
DATABASE_PATH=

# Required for the /api/cars REST API — any random string, sent as the
# X-API-Key header. Leave unset and the API routes just 500; the UI itself
# doesn't need it.
CARPULSE_API_KEY=
